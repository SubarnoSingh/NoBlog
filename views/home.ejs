<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partials/head') %>
    <title>Home</title>
    <style>
        body {
            background-color: #1a1a18;
            color: #e8e0d0;
            font-family: 'Georgia', serif;
            min-height: 100vh;
        }

        .page-wrapper {
            max-width: 1100px;
            margin: 0 auto;
            padding: 3rem 1.5rem 5rem;
        }

        .page-header {
            margin-bottom: 2.5rem;
            padding-bottom: 1.5rem;
            border-bottom: 1px solid #2e2e2a;
        }

        .page-heading {
            font-size: 1.7rem;
            font-weight: 500;
            color: #f0e8d8;
            letter-spacing: 0.01em;
            margin-bottom: 0.3rem;
        }

        .page-subtext {
            font-size: 0.88rem;
            color: #6b6355;
            font-family: 'Arial', sans-serif;
        }

        .blog-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 1.8rem;
        }

        .blog-card {
            background-color: #202020;
            border: 1px solid #2e2e2a;
            border-radius: 10px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            transition: border-color 0.2s, transform 0.2s;
            text-decoration: none;
        }

        .blog-card:hover {
            border-color: #6b6355;
            transform: translateY(-3px);
        }

        .blog-card-img {
            width: 100%;
            height: 190px;
            object-fit: cover;
            display: block;
            filter: brightness(0.85);
            transition: filter 0.2s;
        }

        .blog-card:hover .blog-card-img {
            filter: brightness(0.95);
        }

        .blog-card-body {
            padding: 1.1rem 1.2rem 1.3rem;
            display: flex;
            flex-direction: column;
            flex: 1;
        }

        .blog-card-title {
            font-size: 1.05rem;
            font-weight: 500;
            color: #f0e8d8;
            line-height: 1.4;
            margin-bottom: auto;
            padding-bottom: 1rem;
        }

        .blog-card-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-top: 0.9rem;
            border-top: 1px solid #2a2a26;
        }

        .read-link {
            font-size: 0.8rem;
            font-family: 'Arial', sans-serif;
            font-weight: 600;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            color: #c8b89a;
            text-decoration: none;
            transition: color 0.2s;
        }

        .read-link:hover {
            color: #e0d0b8;
        }

        .read-arrow {
            font-size: 0.9rem;
            color: #6b6355;
            transition: transform 0.2s, color 0.2s;
            display: inline-block;
        }

        .blog-card:hover .read-arrow {
            transform: translateX(3px);
            color: #c8b89a;
        }

        .empty-state {
            text-align: center;
            padding: 5rem 1rem;
            color: #4a4845;
            font-family: 'Arial', sans-serif;
            font-size: 0.95rem;
        }

        .empty-state-icon {
            font-size: 2.5rem;
            margin-bottom: 1rem;
            opacity: 0.3;
        }
    </style>
</head>

<body>
    <%- include('./partials/nav') %>

    <div class="page-wrapper">

        <div class="page-header">
            <h1 class="page-heading">Latest Posts</h1>
            <p class="page-subtext">Thoughts, stories and ideas</p>
        </div>

        <% if (blogs.length === 0) { %>
        <div class="empty-state">
            <div class="empty-state-icon">&#9998;</div>
            <p>No posts yet. Be the first to write something.</p>
        </div>
        <% } else { %>
        <div class="blog-grid">
            <% blogs.forEach(blog => { %>
            <a class="blog-card" href="/blog/<%= blog._id %>">
                <img
                    class="blog-card-img"
                    src="<%= blog.coverImageURL %>"
                    alt="<%= blog.title %>"
                />
                <div class="blog-card-body">
                    <p class="blog-card-title"><%= blog.title %></p>
                    <div class="blog-card-footer">
                        <span class="read-link">Read post</span>
                        <span class="read-arrow">&#8594;</span>
                    </div>
                </div>
            </a>
            <% }) %>
        </div>
        <% } %>

    </div>

    <%- include('./partials/scripts') %>
</body>

</html>