<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partials/head') %>
    <title><%= blog.title %></title>
    <style>
        body {
            background-color: #1a1a18;
            color: #e8e0d0;
            font-family: 'Georgia', serif;
            min-height: 100vh;
        }

        .blog-hero {
            width: 100%;
            max-height: 480px;
            object-fit: cover;
            display: block;
            filter: brightness(0.88);
        }

        .blog-wrapper {
            max-width: 740px;
            margin: 0 auto;
            padding: 2.5rem 1.5rem 5rem;
        }

        .blog-title {
            font-size: 2.1rem;
            font-weight: 500;
            color: #f0e8d8;
            line-height: 1.3;
            letter-spacing: 0.01em;
            margin-bottom: 1.5rem;
        }

        .author-row {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 2rem;
            padding-bottom: 1.5rem;
            border-bottom: 1px solid #2e2e2a;
        }

        .author-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            object-fit: cover;
            border: 1px solid #3a3a36;
        }

        .author-name {
            font-size: 0.88rem;
            color: #a89880;
            font-family: 'Arial', sans-serif;
            letter-spacing: 0.02em;
        }

        .blog-body {
            font-size: 1.05rem;
            line-height: 1.85;
            color: #d4cabb;
            white-space: pre-wrap;
            word-break: break-word;
            font-family: 'Georgia', serif;
        }

        .divider {
            border: none;
            border-top: 1px solid #2e2e2a;
            margin: 3rem 0 2rem;
        }

        .comments-heading {
            font-size: 1rem;
            font-weight: 500;
            font-family: 'Arial', sans-serif;
            color: #8a8278;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin-bottom: 1.5rem;
        }

        .comment-count {
            color: #c8b89a;
        }

        .comment-form {
            display: flex;
            gap: 0.75rem;
            margin-bottom: 2.5rem;
            align-items: flex-start;
        }

        .comment-input {
            flex: 1;
            background-color: #222220;
            border: 1px solid #333330;
            border-radius: 6px;
            color: #e8e0d0;
            font-size: 0.9rem;
            padding: 0.65rem 1rem;
            outline: none;
            transition: border-color 0.2s;
            font-family: 'Georgia', serif;
        }

        .comment-input:focus {
            border-color: #6b6355;
            background-color: #252523;
        }

        .comment-input::placeholder {
            color: #4a4845;
        }

        .comment-submit {
            background-color: #c8b89a;
            color: #1a1a18;
            border: none;
            border-radius: 6px;
            padding: 0.65rem 1.2rem;
            font-size: 0.82rem;
            font-weight: 600;
            letter-spacing: 0.04em;
            cursor: pointer;
            font-family: 'Arial', sans-serif;
            transition: background-color 0.2s, transform 0.1s;
            white-space: nowrap;
        }

        .comment-submit:hover {
            background-color: #d4c4a8;
        }

        .comment-submit:active {
            transform: scale(0.97);
        }

        .comment-list {
            display: flex;
            flex-direction: column;
            gap: 1.4rem;
        }

        .comment-item {
            display: flex;
            gap: 0.85rem;
            align-items: flex-start;
        }

        .comment-avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            object-fit: cover;
            border: 1px solid #2e2e2a;
            flex-shrink: 0;
            margin-top: 2px;
        }

        .comment-bubble {
            background-color: #202020;
            border: 1px solid #2e2e2a;
            border-radius: 8px;
            padding: 0.7rem 1rem;
            flex: 1;
        }

        .comment-author {
            font-size: 0.8rem;
            font-family: 'Arial', sans-serif;
            color: #a89880;
            font-weight: 600;
            margin-bottom: 0.3rem;
            letter-spacing: 0.02em;
        }

        .comment-content {
            font-size: 0.92rem;
            color: #c8c0b0;
            line-height: 1.6;
            white-space: pre-wrap;
            word-break: break-word;
            margin: 0;
            font-family: 'Georgia', serif;
        }
    </style>
</head>

<body>
    <%- include('./partials/nav') %>

    <img class="blog-hero" src="<%= blog.coverImageURL %>" alt="<%= blog.title %> cover" />

    <div class="blog-wrapper">

        <h1 class="blog-title"><%= blog.title %></h1>

        <div class="author-row">
            <img class="author-avatar" src="<%= blog.createdBy.profileImageURL %>" alt="<%= blog.createdBy.fullName %>" />
            <span class="author-name"><%= blog.createdBy.fullName %></span>
        </div>

        <p class="blog-body"><%= blog.body %></p>

        <hr class="divider" />

        <p class="comments-heading">
            Comments <span class="comment-count">(<%= comments.length %>)</span>
        </p>

        <% if (locals.user) { %>
        <form class="comment-form" action="/blog/comment/<%= blog._id %>" method="POST">
            <input
                class="comment-input"
                type="text"
                name="content"
                placeholder="Leave a comment…"
            />
            <button class="comment-submit" type="submit">Post</button>
        </form>
        <% } %>

        <div class="comment-list">
            <% comments.forEach(comment => { %>
            <div class="comment-item">
                <img class="comment-avatar" src="<%= comment.createdBy.profileImageURL %>" alt="<%= comment.createdBy.fullName %>" />
                <div class="comment-bubble">
                    <p class="comment-author"><%= comment.createdBy.fullName %></p>
                    <pre class="comment-content"><%= comment.content %></pre>
                </div>
            </div>
            <% }) %>
        </div>

    </div>

    <%- include('./partials/scripts') %>
</body>

</html>